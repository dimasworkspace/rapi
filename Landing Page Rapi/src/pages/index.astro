---
import Base from '@/layouts/Base.astro'
import Header from '@/components/Header.astro'
import Hero from '@/components/Hero.astro'
import Why from '@/components/Why.astro'
import Features from '@/components/Features.astro'
import HowTo from '@/components/HowTo.astro'
import Trust from '@/components/Trust.astro'
import Faq from '@/components/Faq.astro'
import CtaFooter from '@/components/CtaFooter.astro'
---

<Base>
  <Header />
  <main>
    {/* Alurnya: pancing -> akui masalahnya -> tunjukkan jalannya ->
        permudah langkah pertama -> bangun kepercayaan -> jawab keraguan -> ajak */}
    <Hero />
    <Why />
    <Features />
    {/* Garis sobek struk — pemisah yang cuma masuk akal buat produk keuangan */}
    <div class="rapi-container">
      <div class="rapi-sobek text-rapi-gray-300" aria-hidden="true"></div>
    </div>
    <HowTo />
    <Trust />
    <Faq />
  </main>
  <CtaFooter />
</Base>
