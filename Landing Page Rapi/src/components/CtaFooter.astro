---
import { APP_URL, SITE } from '@/consts'
const tahun = new Date().getFullYear()
---

<section class="relative overflow-hidden bg-rapi-navy py-20 text-white md:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -bottom-24 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-rapi-blue/40 blur-3xl"></div>
  </div>

  <div class="rapi-container relative text-center">
    <h2 class="mx-auto max-w-2xl text-[clamp(1.75rem,4.5vw,2.75rem)] font-extrabold leading-tight tracking-tight">
      Catat satu transaksi hari ini. Cuma itu.
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-[16px] leading-relaxed text-white/70">
      Nggak usah mikirin sebulan ke depan. Mulai dari yang barusan kamu beli.
    </p>
    <a href={APP_URL} class="rapi-btn-primary mt-8">Mulai Gratis Sekarang</a>
    <p class="mt-4 text-[13px] text-white/45">Gratis · Tanpa kartu kredit · Siap dalam 2 menit</p>
  </div>
</section>

<footer class="bg-rapi-navy pb-10 text-white/45">
  <div class="rapi-container flex flex-col items-center gap-3 border-t border-white/10 pt-8 sm:flex-row sm:justify-between">
    <p class="text-[13px]">{SITE.tagline}</p>
    <p class="text-[12px]">© {tahun} {SITE.name} · {SITE.hashtag}</p>
  </div>
</footer>
