---
import { APP_URL, NAV } from '@/consts'
---

<header class="sticky top-0 z-50 border-b border-rapi-gray-300/40 bg-rapi-offwhite/85 backdrop-blur-xl">
  <div class="rapi-container flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="Rapi — beranda">
      <img src="/logo-rapi.png" alt="Rapi" width="104" height="63" class="h-8 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navigasi utama">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-[14px] font-semibold text-rapi-gray-600 transition-colors hover:text-rapi-navy"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href={APP_URL} data-magnetic class="rapi-btn-primary !min-h-10 !px-4 !text-[14px]">
      Buka Rapi
    </a>
  </div>

  <!-- Garis progress baca. Murni CSS (animation-timeline: scroll()) — nol JS.
       Browser yang belum dukung cuma nggak menampilkannya, nggak ada yang rusak. -->
  <div
    aria-hidden="true"
    class="rapi-progress absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-rapi-blue to-rapi-yellow"
  >
  </div>
</header>
