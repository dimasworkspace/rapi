---
import '@/styles/global.css'
import { SITE } from '@/consts'

interface Props {
  title?: string
  description?: string
}

const { title, description = SITE.description } = Astro.props
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`
// 1200×630 — rasio yang dipakai WhatsApp, X, dan LinkedIn buat kartu pratinjau.
// Ikon app persegi kalau dipakai di sini bakal dipotong kiri-kanan.
const ogImage = new URL('/og-image.png', Astro.site).href
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#111835" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/app/apple-touch-icon.png" />

    <!-- Manifest MILIK APP, ditautkan dari landing page.
         Scope-nya "/" dan start_url-nya "/app/", jadi halaman ini masuk
         jangkauan manifest — syarat wajib supaya browser mau menawarkan
         pemasangan di sini, sementara yang dipasang tetap aplikasinya. -->
    <link rel="manifest" href="/app/manifest.webmanifest" />

    <!-- Open Graph — dipakai waktu link dibagikan di WhatsApp, IG, X -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rapi — catat keuangan tanpa ribet" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script is:inline>
      // Tandai bahwa JS hidup — dipakai CSS buat memutuskan boleh menyembunyikan
      // elemen [data-reveal] atau nggak. Ditaruh inline & duluan supaya nggak
      // ada kedipan konten.
      document.documentElement.classList.add('js')
    </script>

    <script>
      // Semua gerakan halaman diatur di satu file
      import '@/scripts/motion'
    </script>

    <script is:inline>
      // Daftarkan service worker milik app dengan scope "/" supaya halaman ini
      // ikut dikuasai. Chrome baru mengirim `beforeinstallprompt` kalau halaman
      // yang dibuka dikuasai SW yang punya penangan fetch — tanpa ini, tombol
      // "Pasang" di landing page nggak akan pernah aktif.
      //
      // File-nya ada di /app/sw.js tapi mengklaim scope "/", yang cuma
      // diizinkan berkat header Service-Worker-Allowed di vercel.json.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/app/sw.js', { scope: '/' }).catch((e) => {
            // Bukan hal fatal: halaman tetap jalan, cuma tombol pasang otomatis
            // nggak muncul dan user memakai petunjuk manual.
            console.warn('[rapi] service worker gagal didaftarkan:', e)
          })
        })
      }
    </script>
  </body>
</html>
