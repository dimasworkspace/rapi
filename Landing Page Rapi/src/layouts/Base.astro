---
import '@/styles/global.css'
import { SITE } from '@/consts'

interface Props {
  title?: string
  description?: string
}

const { title, description = SITE.description } = Astro.props
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`
// 1200×630 — rasio yang dipakai WhatsApp, X, dan LinkedIn buat kartu pratinjau.
// Ikon app persegi kalau dipakai di sini bakal dipotong kiri-kanan.
const ogImage = new URL('/og-image.png', Astro.site).href
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#111835" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />

    <!-- Open Graph — dipakai waktu link dibagikan di WhatsApp, IG, X -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rapi — catat keuangan tanpa ribet" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script is:inline>
      // Tandai bahwa JS hidup — dipakai CSS buat memutuskan boleh menyembunyikan
      // elemen [data-reveal] atau nggak. Ditaruh inline & duluan supaya nggak
      // ada kedipan konten.
      document.documentElement.classList.add('js')
    </script>

    <script>
      // Reveal saat digulir. Sekali muncul, pengamatnya dilepas — nggak ada
      // gunanya terus memantau elemen yang sudah selesai animasinya.
      const target = document.querySelectorAll('[data-reveal]')
      const kurangiGerak = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (kurangiGerak) {
        target.forEach((el) => el.classList.add('is-visible'))
      } else {
        const pengamat = new IntersectionObserver(
          (entri) => {
            entri.forEach((e) => {
              if (!e.isIntersecting) return
              e.target.classList.add('is-visible')
              pengamat.unobserve(e.target)
            })
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        )
        target.forEach((el) => pengamat.observe(el))
      }
    </script>
  </body>
</html>
