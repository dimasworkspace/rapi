# Salin file ini jadi `.env.local`, lalu isi dari Supabase Dashboard:
# Project Settings → API
#
# Kosongkan saja kalau mau jalan mode lokal (data cuma di perangkat, tanpa akun).
#
# ⚠️ anon key AMAN di client (dilindungi Row Level Security).
#    JANGAN PERNAH menaruh `service_role` key di file ini.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
